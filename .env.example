# ------------------------------------------------------------------
# Blinka Agent - variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas el `.env` real al repositorio (solo datos ficticios).
# ------------------------------------------------------------------

# API key de Google AI Studio (plan gratuito).
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo Flash vigente. Confirmar el nombre exacto en AI Studio.
# Ejemplos habituales: gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Puerto del servidor Express (sirve la API y el build de React)
PORT=3000

# ------------------------------------------------------------------
# Modo de ejecucion del LLM
#   auto   -> usa Gemini si hay GEMINI_API_KEY; si no, cae a modo offline
#   gemini -> exige Gemini (falla si no hay key)
#   mock   -> nunca llama a la red (usa cache y respuestas simuladas)
#   cache  -> usa la cache en disco; si no hay entrada, cae a mock
# ------------------------------------------------------------------
LLM_MODE=auto

# Limite de pasos del loop del agente por factura
MAX_STEPS=6

# Si es "1", la evaluacion y la demo no dependen de la API en vivo.
OFFLINE_FIRST=1

# Directorio de cache de respuestas del LLM
LLM_CACHE_DIR=eval/cache

# La evaluacion corre offline con fixtures (CA-10). Con EVAL_LIVE=1 usa Gemini.
# EVAL_LIVE=1

# Espera base (ms) entre reintentos de la cola
QUEUE_BACKOFF_MS=500

# ------------------------------------------------------------------
# Replica en la nube (Turso / libSQL). Opcional: sin estas dos variables
# la app funciona igual, solo con SQLite local (data/blinka.sqlite).
#
# La app sigue leyendo y escribiendo en SQLite local; estas credenciales
# solo activan el espejo hacia Turso (esquema, datos y restauracion).
# Crear la base: https://docs.turso.tech/quickstart
# ------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 0 desactiva el espejo sin borrar las credenciales
TURSO_SYNC=1
# Cada cuanto se revisa si hay cambios que empujar (ms)
TURSO_SYNC_INTERVAL_MS=5000
# Espera maxima al crear esquema/restaurar al arrancar (ms)
TURSO_TIMEOUT_MS=8000
